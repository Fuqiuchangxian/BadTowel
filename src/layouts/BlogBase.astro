---
// 博客 / 诗歌的独立布局：与主站共用极简样式，但页头只有笔名，不链回个人主页。
import '../styles/global.css';
import { sections, type Kind } from '../lib/blog';
// 这两个栏目用笔名，不出现真名。
const author = '毛巾坏';

interface Props {
  kind?: Kind;
  title?: string;
  description?: string;
  /** 阅读页：右上角显示「返回列表」 */
  back?: boolean;
}

const { kind = 'blog', title, back = false } = Astro.props;
const { label, path } = sections[kind];
const { description = `${author}的${label}。` } = Astro.props;
const fullTitle = title ? `${title} · ${author}的${label}` : `${label} · ${author}`;
const canonical = Astro.site && new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="article" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <header class="top">
      <span>{author}<span class="sep">/</span><a href={path}>{label}</a></span>
      {back && <a class="meta" href={path}>← 返回列表</a>}
    </header>
    <main>
      <slot />
    </main>
    <footer class="end">
      <nav class="sites" aria-label="站点">
        <a href="/">BadTowel</a>
        {(Object.keys(sections) as Kind[]).map((k) => (k === kind ? <span>{sections[k].label}</span> : <a href={sections[k].path}>{sections[k].label}</a>))}
      </nav>
      <p>© {new Date().getFullYear()} {author}</p>
    </footer>
  </body>
</html>

<style>
  .sites { display: flex; gap: 0 1.4em; margin-bottom: 12px; }
  .sites span { color: var(--ink); }
</style>

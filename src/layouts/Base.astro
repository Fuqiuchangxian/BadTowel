---
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import { nav, profile, privacyNote } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = profile.description } = Astro.props;
const fullTitle = title ? `${title} · ${profile.nameZh} Profile` : `${profile.nameZh} ${profile.nameEn} · Profile`;
const canonical = Astro.site && new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
  </head>
  <body>
    <header class="top">
      <span class="brand">
        <a class="logo" href="/" aria-label="BadTowel 导航"><Mark name="towel" size={18} /></a>
        <a href="/profile">{profile.lab}</a><span class="sep">/</span><span class="muted">Profile</span>
      </span>
      <nav class="nav" aria-label="主导航">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="end">
      <nav class="sites" aria-label="站点">
        <a href="/">BadTowel</a><a href="/blog/">博客</a><a href="/poetry/">诗歌</a>
      </nav>
      <p class="privacy">{privacyNote}</p>
      <p>© {new Date().getFullYear()} {profile.nameZh} · 古法手搓，AI 协作</p>
    </footer>
  </body>
</html>

<style>
  .brand { display: inline-flex; align-items: center; white-space: nowrap; }
  .logo { margin-right: 0.8em; display: inline-flex; }
  .nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0 1.2em; color: var(--gray); }
  .nav a:hover { color: var(--ink); }
  @media (max-width: 600px) {
    .top { flex-direction: column; align-items: flex-start; gap: 6px; }
    .nav { justify-content: flex-start; gap: 0 1.4em; }
  }
  .sites { display: flex; gap: 0 1.4em; margin-bottom: 16px; }
  .privacy { margin-bottom: 12px; line-height: 1.7; }
</style>

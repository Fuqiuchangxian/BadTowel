---
import Base from '../../layouts/Base.astro';

const facts = [
  { k: '角色', v: 'AI 产品实习生 · BlueAI 数据中台组' },
  { k: '场景', v: '汽车事业群 · 达人投放脚本审核' },
  { k: '平台', v: 'OpenClaw · 内部 Flare 平台' },
  { k: '时间', v: '2026.08 — 2026.09' },
];

const steps = [
  { no: '01', t: '词库全文扫', d: '拿词库把全文扫一遍——只召回，不裁决。' },
  { no: '02', t: '独立语义判断', d: '没命中关键词，但话里话外是「必然、包你、无限、绝对」的，也要抓出来。' },
  { no: '03', t: '产品事实双源校验', d: '产品事实要两个来源对得上才敢用；对不上就标冲突，绝不自己拍板。' },
];

const fallbacks = [
  '客户 Brief 明确写了的话照用，不批。',
  '只有车型对得上才加载那张声明卡；对不上就记缺口，绝不拿别的车替代。',
];

const ruled = [
  { t: '能扫的', d: '极限词、红线词、禁用词、参数——进词库机扫。' },
  { t: '流程关卡', d: '三必填 + 确认门禁、交付状态机、写入前映射检查——定死。' },
  { t: '批注写法', d: '不带方括号标签、1–3 句 60 字、同段合并——定死。' },
  { t: '判断类', d: '歧视、人设前后矛盾、卖点是否硬塞——只给检查维度和边界，留给模型。', open: true },
];

const gates = [
  { t: '不可改', d: '法律与平台规则文件直接只读。' },
  { t: '需确认', d: '可改的审核标准必须走「提变更 → 负责人确认 → 同步索引」。' },
  { t: '分层维护', d: 'Agent 维护的只是次要的审核规则层，底线与事实来源永远只读。' },
];
---

<Base title="脚本审核 Agent" description="如何把一个人工审核流程，拆成可复用、可约束、可持续迭代的 Agent 系统。">
  <article>
    <p class="meta"><a href="/profile#experience">← 返回经历</a></p>
    <h1>脚本审核 Agent</h1>
    <p class="meta">CASE STUDY · 蓝色光标</p>
    <p class="sub">如何把一个人工审核流程，拆成<strong>可复用、可约束、可持续迭代</strong>的 Agent 系统。</p>
    <dl class="facts">
      {facts.map((f) => <div><dt class="meta">{f.k}</dt><dd>{f.v}</dd></div>)}
    </dl>

    <h2><span class="n meta">01</span>背景与目标</h2>
    <p>
      蓝标本来以提供服务盈利，现在会做面向内部的 AI 提效，以及基于沉淀下来的能力对客户做 Agent 交付。我负责的是汽车事业群达人投放方向的脚本审核 Agent 落地，服务于内部业务同学。
    </p>
    <p>
      预期是把它扩展成整个汽车事业群通用的审核 Agent——<strong>改变人与人的协作模式，让以后客户可以直接通过这个数字员工对接完成这一部分工作。</strong>
    </p>

    <h2><span class="n meta">02</span>两层架构：碰原件的不做判断，做判断的碰不到原件</h2>
    <p>
      一个管「跑文件、读文档、写批注、回读、上传」，另一个只管「看内容、下判断」。两边不直接碰对方的活，靠任务目录里的文件交接。
    </p>
    <ol class="arch" aria-label="架构示意：主 Agent 处理原始文件，经任务目录交接给只读的审核子 Agent">
      <li><span class="meta">INPUT</span><b>客户材料</b><span class="muted">Word / Excel 原稿 · Brief · 声明卡</span></li>
      <li class="edge meta">↓</li>
      <li><span class="meta">MAIN AGENT</span><b>文件工程</b><span class="muted">解析文档 · 执行脚本 · 写批注 · 回读 · 上传 · 飞书收发</span></li>
      <li class="edge meta">⇅ 任务目录 · 抽取文本</li>
      <li><span class="meta">SUB AGENT</span><b>内容审核</b><span class="muted">只剩 4 个读写工具 · 看内容 · 下判断</span></li>
    </ol>
    <h3>为什么拆两份</h3>
    <p>
      解析 Word / Excel 要跑脚本，得能执行命令；但审核那个如果拿到客户原始文件，就有泄露和改坏的风险。所以会碰原始文件的不做判断，做判断的碰不到原始文件。
    </p>
    <h3>为什么用 OpenClaw</h3>
    <p>
      它天然支持多 Agent 编排、能精确把子 Agent 的工具剪到只剩读写、有 Skill 机制能版本化审核逻辑，还自带文件上传拿链接与飞书收发。别的框架这些都得自己搭。
    </p>

    <h2><span class="n meta">03</span>流程拆解：能定死的定死，要判断的留给模型</h2>
    <p>
      我把人工审核脚本的完整过程拆成了十几步，从「收到材料」到「交付批注版」全连起来。拆的依据是：<strong>哪些步骤能定死、能枚举、能机器验证，就写成规则；哪些需要靠理解上下文做判断，只给检查维度和边界。</strong>
    </p>
    <p>最关键的，是把「谁做事、谁只读、中间靠什么交接」分清楚。</p>
    <ul class="rows">
      {
        ruled.map((r) => (
          <li>
            <b>{r.t}</b>
            <span class="muted">{r.d}</span>
            <span class:list={['meta', 'tag', { open: r.open }]}>{r.open ? '交给模型' : '规则化'}</span>
          </li>
        ))
      }
    </ul>

    <h2><span class="n meta">04</span>审核逻辑：三步走，再加两条兜底</h2>
    <ol class="rows">
      {
        steps.map((s) => (
          <li>
            <span class="meta">{s.no}</span>
            <div><b>{s.t}</b><p class="muted">{s.d}</p></div>
          </li>
        ))
      }
    </ol>
    <p class="meta fb">FALLBACK</p>
    <ul class="dots">{fallbacks.map((f) => <li>{f}</li>)}</ul>

    <h2><span class="n meta">05</span>工具裁剪与边界</h2>
    <h3>裁了什么</h3>
    <p>子 Agent 只剩四个读写工具。执行命令、飞书、网络、后台、记忆、起子 Agent——全禁。</p>
    <h3>卡了什么</h3>
    <p>
      原始脚本、Brief、知识库、声明卡只读不覆盖不删；改知识库必须先出提案等人确认；不碰配置和正式 Skill；不发外部消息，只在本项目目录内活动。
    </p>
    <p>
      <strong>标准接入流程</strong>：先收材料登记，三样齐了主动问一句「开始审核吗」，用户点头才动。
    </p>
    <p>
      <strong>为什么走向 A2A</strong>：能力和权限天然要拆成两个 Agent，用文件做接口能让任何一步失败单独重跑，也保证子 Agent 永远拿不到原件。
    </p>

    <h2><span class="n meta">06</span>Prompt 与上下文控制</h2>
    <p>
      规则不往 prompt 里堆全文，而是放到外部文件；prompt 只留「方法 + 边界」的骨架，用读取路径代替内联。好处是 <strong>prompt 不随规则增多而变大。</strong>
    </p>
    <ul class="rows">
      <li><b>11</b><span class="muted">个规则文件用到才读，不预载</span></li>
      <li><b>1 : 1</b><span class="muted">每次任务独立目录，历史产物不背进新会话</span></li>
      <li><b>按需</b><span class="muted">声明卡按车型匹配，只加载命中那张</span></li>
    </ul>

    <h2><span class="n meta">07</span>自进化知识库：靠谱吗？</h2>
    <p>
      参考 LLM-Wiki 的思路，把知识库做成给模型读的结构化三层：一份<strong>盘点</strong>（每个文件管什么、硬性还是建议性）、一份<strong>冲突清单</strong>、一份<strong>机器能读的规则索引</strong>。
    </p>
    <p>防污染靠三道闸：</p>
    <ol class="rows">
      {
        gates.map((g, i) => (
          <li>
            <span class="meta">GATE {i + 1}</span>
            <div><b>{g.t}</b><p class="muted">{g.d}</p></div>
          </li>
        ))
      }
    </ol>

    <h2><span class="n meta">08</span>迭代与问题攻坚</h2>
    <h3>新增的真规则</h3>
    <ul class="dots">
      <li>元信息完整性</li>
      <li>真实经历核验</li>
      <li>没有产品文档时的降级口径</li>
      <li>隐喻歧视专项检测</li>
    </ul>
    <h3>修掉的执行偏差</h3>
    <ul class="dots">
      <li>辅助驾驶判得过严</li>
      <li>批注带方括号标签</li>
      <li>创意建议太啰嗦</li>
      <li>扩展支持的文件格式</li>
    </ul>
    <p>
      <strong>上下文膨胀的三层解法</strong>：规则外置让 prompt 瘦身；预检机制「用到才读、不预载」；负责人反馈对话太长时，建议开新会话甩掉历史包袱。
    </p>

    <p class="quote">确定性交给规则，判断交给模型，<br />边界交给架构。</p>
    <p class="cta">
      <a class="u" href="/profile#experience">回到全部经历</a><span class="muted"> · </span><a class="u" href="/profile#works">看看工作之外</a>
    </p>
  </article>
</Base>

<style>
  h1 { margin-top: 40px; font-size: 24px; line-height: 1.5; letter-spacing: 0.04em; }
  .sub { margin-top: 24px; font-size: 18px; }
  .facts { margin-top: 32px; }
  .facts div { display: grid; grid-template-columns: 4.5em 1fr; column-gap: 16px; padding: 2px 0; }
  .facts dt { line-height: inherit; }

  h2 { margin: 88px 0 20px; font-size: 18px; line-height: 1.6; }
  h2 .n { display: block; font-weight: 400; letter-spacing: 0.1em; }
  h3 { margin: 1.8em 0 0.3em; font-size: 16px; }
  article > p + p { margin-top: 1em; }
  strong { font-weight: 600; }

  .arch { list-style: none; margin: 32px 0; padding: 20px 24px; border: 1px solid var(--line); }
  .arch li:not(.edge) { display: flex; flex-direction: column; }
  .arch .edge { padding: 6px 0; }

  .rows { list-style: none; padding: 0; margin: 24px 0; }
  .rows li {
    display: grid;
    grid-template-columns: 4.5em 1fr auto;
    align-items: baseline;
    column-gap: 16px;
    padding: 10px 0;
    border-top: 1px solid var(--line);
  }
  .rows li:last-child { border-bottom: 1px solid var(--line); }
  .rows li > div { grid-column: span 2; }
  .tag.open { color: var(--ink); }

  .fb { margin-top: 24px; letter-spacing: 0.1em; }
  .dots { margin: 0; padding-left: 1.2em; }

  .quote { margin-top: 120px; font-size: 18px; font-weight: 600; line-height: 1.7; }
  .cta { margin-top: 24px; }

  @media (max-width: 600px) {
    .rows li { grid-template-columns: 1fr auto; }
    .rows li > :nth-child(2) { grid-column: 1 / -1; grid-row: 2; }
    .rows li > div { grid-column: 1 / -1; }
  }
</style>

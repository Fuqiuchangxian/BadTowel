---
// 导航页（badtowel.com）：把几个站放在一起，只有一列字。
import '../styles/global.css';
import Mark from '../components/Mark.astro';

const sites = [
  { icon: 'chat', name: '博客', desc: '关于生活、情绪和当下', href: '/blog/' },
  { icon: 'feather', name: '诗歌', desc: '写下来的诗', href: '/poetry/' },
  { icon: 'book', name: '知识库', desc: '飞书 ↗', href: 'https://my.feishu.cn/wiki/PIB2wK1pRiDzHDk0yA6cf7ovnzd', external: true },
] as const;
// 个人主页放在列表最后，不抢眼
const profile = { icon: 'user', name: 'Profile', desc: '个人主页', href: '/profile' } as const;
const description = 'BadTowel：个人主页、博客、诗歌与知识库的入口。';
const canonical = Astro.site && new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>BadTowel</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content="BadTowel" />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <header class="top">
      <span class="brand"><Mark name="towel" size={18} />BadTowel</span>
      <span class="meta">毛巾坏</span>
    </header>
    <main>
      <h1>BadTowel</h1>
      <p class="muted lead">几个放在一起的小站。</p>
      <ul class="sites">
        {
          sites.map((s) => (
            <li>
              <a href={s.href} {...('external' in s ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                <span class="name"><Mark name={s.icon} />{s.name}</span>
                <span class="desc">{s.desc}</span>
              </a>
            </li>
          ))
        }
        <li class="quiet">
          <a href={profile.href}>
            <span class="name"><Mark name={profile.icon} />{profile.name}</span>
            <span class="desc">{profile.desc}</span>
          </a>
        </li>
      </ul>
    </main>
    <footer class="end">© {new Date().getFullYear()} BadTowel</footer>
  </body>
</html>

<style>
  .brand { display: inline-flex; align-items: center; gap: 0.8em; }
  h1 { font-size: 24px; line-height: 1.5; letter-spacing: 0.04em; }
  .lead { margin-top: 4px; }
  .sites { list-style: none; padding: 0; margin: 56px 0 0; }
  .sites a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    column-gap: 24px;
    padding: 10px 0;
  }
  .sites a:hover { text-decoration: none; }
  .name { display: inline-flex; align-items: center; gap: 0.7em; min-width: 7em; }
  .sites a:hover .name { text-decoration: underline; text-underline-offset: 0.3em; text-decoration-thickness: 1px; }
  .quiet { margin-top: 24px; }
  .quiet .name, .quiet .desc { color: var(--gray); font-size: 14px; }
  .quiet a:hover .name { color: var(--ink); }
  .desc { text-align: right; color: var(--gray); font-size: 14px; }
  @media (max-width: 600px) {
    .sites a { grid-template-columns: 1fr; row-gap: 0; padding: 12px 0; }
    .quiet { margin-top: 24px; }
  .quiet .name, .quiet .desc { color: var(--gray); font-size: 14px; }
  .quiet a:hover .name { color: var(--ink); }
  .desc { text-align: left; padding-left: 1.7em; font-size: 13px; }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config';
const songs=(await getCollection('songs')).sort((a,b)=>new Date(b.data.date).getTime()-new Date(a.data.date).getTime());
const albums=[...new Set(songs.map(s=>s.data.album).filter(Boolean))];
const LOCK=`<span class="lock-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>`;
const STAR=`<span class="star-icon"><svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg></span>`;
---
<BaseLayout title="音乐">
  <div class="flex" style="position:fixed;top:56px;left:0;right:0;bottom:0;">
    <div class="side-panel">
      <div class="filter-bar" id="album-filter"><button class="filter-tag active" data-filter="">全部</button>{albums.map(a=><button class="filter-tag" data-filter={a}>{a}</button>)}</div>
      <div class="flex-1 overflow-y-auto" id="song-list">
        {songs.map(song=>(<div class="list-item" data-id={song.slug} data-album={song.data.album}><div class="list-item-title"><span>{song.data.title}</span>{song.data.starred&&<Fragment set:html={STAR}/>}{!song.data.public&&<Fragment set:html={LOCK}/>}</div><div class="flex items-center gap-1.5 flex-wrap"><span class="list-item-date">{song.data.date}</span>{song.data.platforms.map(p=><span class="tag-gray">{p.name}</span>)}</div></div>))}
      </div>
    </div>
    <div class="reader-area" id="song-reader"><div class="reader-empty"><img src={siteConfig.placeholderImage} alt="" onerror="this.style.display='none'"/></div></div>
  </div>
  <script define:vars={{songsData:songs.map(s=>({slug:s.slug,title:s.data.title,date:s.data.date,album:s.data.album,platforms:s.data.platforms,artImage:s.data.artImage,notes:s.data.notes,body:s.body,isPublic:s.data.public!==false,lockReason:s.data.lockReason||'',starred:!!s.data.starred}))}}>
    const list=document.getElementById('song-list'),reader=document.getElementById('song-reader'),filterBar=document.getElementById('album-filter'),md=window.__BT_MD;
    function isAdmin(){return !!(window).__BT_ADMIN}
    const lockSvg=`<svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`;
    function lockScreen(r){return `<div class="reader-card animate-fade-in-up" style="text-align:center;padding:80px 56px;"><div style="margin:0 auto 20px;opacity:.2;width:56px;">${lockSvg}</div><h2 style="font-size:1.2rem;font-weight:600;color:var(--gray-700);margin-bottom:12px;font-family:'Noto Sans SC',sans-serif;">当前内容未公开</h2><p style="font-size:.875rem;color:var(--gray-400);font-family:'Noto Sans SC',sans-serif;line-height:1.8;max-width:360px;margin:0 auto;white-space:pre-line;">${r||'作者暂未公开此内容'}</p></div>`}
    const starHint=`<div class="starred-hint"><svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg><span>这是作者偏爱的作品之一</span></div>`;
    const adminBadge=t=>!t?`<span style="font-size:.6875rem;font-family:'Noto Sans SC',sans-serif;padding:1px 8px;border-radius:4px;color:#f59e0b;background:rgba(245,158,11,.1);margin-left:8px;">未公开</span>`:'';

    filterBar.addEventListener('click',e=>{const btn=e.target.closest('.filter-tag');if(!btn)return;const f=btn.dataset.filter;filterBar.querySelectorAll('.filter-tag').forEach(b=>b.classList.remove('active'));btn.classList.add('active');list.querySelectorAll('.list-item').forEach(item=>{item.style.display=!f||(item.dataset.album||'')===f?'':'none'})});
    list.addEventListener('click',e=>{
      const item=e.target.closest('.list-item');if(!item)return;const song=songsData.find(s=>s.slug===item.dataset.id);if(!song)return;
      list.querySelectorAll('.list-item').forEach(i=>i.classList.remove('active'));item.classList.add('active');
      if(!song.isPublic&&!isAdmin()){reader.innerHTML=lockScreen(song.lockReason);return}
      let embeds='';song.platforms.forEach(p=>{const url=p.url||'';const nId=url.match(/music\.163\.com.*[?&]id=(\d+)/);if(p.name==='网易云'&&nId)embeds+=`<div style="margin:16px 0;border-radius:12px;overflow:hidden;box-shadow:var(--shadow-sm);border:.5px solid rgba(0,0,0,.06);"><iframe src="https://music.163.com/outchain/player?type=2&id=${nId[1]}&auto=0&height=66" style="width:100%;height:86px;border:none;display:block;"></iframe></div>`;const bv=url.match(/bilibili\.com\/video\/(BV\w+)/);if(p.name==='B站'&&bv)embeds+=`<div style="margin:16px 0;border-radius:12px;overflow:hidden;box-shadow:var(--shadow-sm);border:.5px solid rgba(0,0,0,.06);aspect-ratio:16/9;"><iframe src="https://player.bilibili.com/player.html?bvid=${bv[1]}&autoplay=0" style="width:100%;height:100%;border:none;display:block;" allowfullscreen></iframe></div>`});
      const pills=song.platforms.map(p=>`<a href="${p.url}" target="_blank" rel="noreferrer" class="link-pill"><span style="font-size:.75rem;">↗</span> ${p.name}</a>`).join('');
      const bodyHtml=md.inlineFormat(song.body);
      let html=`<div class="reader-card animate-fade-in-up"><h1 class="reader-title">${song.title}${adminBadge(song.isPublic)}</h1>${song.starred?starHint:''}<div class="reader-meta"><span class="list-item-date">${song.date}</span>${song.album?`<span class="tag-accent" style="padding:2px 12px;border-radius:6px;font-size:.75rem;">${song.album}</span>`:''}</div><div style="display:flex;gap:8px;margin-bottom:20px;">${pills}</div>${embeds}<div style="height:1px;background:var(--gray-200);margin:24px 0;"></div><div class="lyrics-body" style="position:relative;">${bodyHtml}`;
      if(song.artImage)html+=`<img src="${song.artImage}" alt="曲绘" style="position:absolute;bottom:0;right:0;width:180px;height:180px;object-fit:contain;pointer-events:none;opacity:.75;"/>`;
      html+=`</div>`;if(song.notes)html+=`<button class="backstory-btn" id="notes-btn">— 创作手记</button>`;html+=`</div>`;reader.innerHTML=html;
      document.getElementById('notes-btn')?.addEventListener('click',()=>showModal('创作手记',song.notes));
    });
    function showModal(t,c){const ov=document.createElement('div');ov.className='modal-overlay';const m=document.createElement('div');m.className='modal-panel';m.style.cssText=`left:${window.innerWidth/2-200}px;top:${window.innerHeight/2-150}px;width:420px;max-width:90vw;max-height:70vh;`;m.innerHTML=`<div class="modal-handle" id="mh"><div style="display:flex;align-items:center;gap:8px;"><svg width="12" height="12" viewBox="0 0 12 12" fill="#a3a3a3"><circle cx="3" cy="3" r="1.5"/><circle cx="9" cy="3" r="1.5"/><circle cx="3" cy="6" r="1.5"/><circle cx="9" cy="6" r="1.5"/><circle cx="3" cy="9" r="1.5"/><circle cx="9" cy="9" r="1.5"/></svg><span style="font-size:.875rem;font-weight:600;color:var(--gray-800);font-family:'Noto Sans SC',sans-serif;">${t}</span></div><button class="modal-close" id="mc">×</button></div><div class="modal-body" style="max-height:calc(70vh - 50px);white-space:pre-line;">${c}</div>`;document.body.appendChild(ov);document.body.appendChild(m);let d=false,ox=0,oy=0;m.querySelector('#mh').addEventListener('mousedown',e=>{d=true;ox=e.clientX-m.getBoundingClientRect().left;oy=e.clientY-m.getBoundingClientRect().top});document.addEventListener('mousemove',e=>{if(!d)return;m.style.left=(e.clientX-ox)+'px';m.style.top=(e.clientY-oy)+'px'});document.addEventListener('mouseup',()=>{d=false});const close=()=>{ov.remove();m.remove()};ov.addEventListener('click',close);m.querySelector('#mc').addEventListener('click',close)}
  </script>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config';
const blogs=(await getCollection('blogs')).sort((a,b)=>new Date(b.data.date).getTime()-new Date(a.data.date).getTime());
const poems=await getCollection('poems');const songs=await getCollection('songs');const notes=await getCollection('notes');
const allContent=[...poems.map(p=>({slug:p.slug,type:'poem',typeLabel:'诗歌',title:p.data.title,excerpt:(p.body||'').split('\n').slice(0,4).join('\n'),url:'/poetry'})),...songs.map(s=>({slug:s.slug,type:'song',typeLabel:'音乐',title:s.data.title,excerpt:(s.body||'').split('\n').slice(0,4).join('\n'),url:'/music'})),...blogs.map(b=>({slug:b.slug,type:'blog',typeLabel:'博客',title:b.data.title,excerpt:(b.body||'').split('\n').slice(0,3).join('\n'),url:'/blog'})),...notes.map(n=>({slug:n.slug,type:'note',typeLabel:'笔记',title:n.data.title,excerpt:(n.body||'').split('\n').slice(0,3).join('\n'),url:'/notes'}))];
const LOCK=`<span class="lock-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>`;
const STAR=`<span class="star-icon"><svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg></span>`;
---
<BaseLayout title="博客">
  <div class="flex" style="position:fixed;top:56px;left:0;right:0;bottom:0;">
    <div class="side-panel"><div class="flex-1 overflow-y-auto" id="blog-list">
      {blogs.map(blog=>(<div class="list-item" data-id={blog.slug}><div class="list-item-title"><span>{blog.data.title}</span>{blog.data.starred&&<Fragment set:html={STAR}/>}{!blog.data.public&&<Fragment set:html={LOCK}/>}</div><div class="flex items-center gap-2"><span class="list-item-date">{blog.data.date}</span><span class="reading-time"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>{Math.max(1,Math.round((blog.body||'').length/400))} 分钟</span></div></div>))}
    </div></div>
    <div class="reader-area" id="blog-reader"><div class="reader-empty"><img src={siteConfig.placeholderImage} alt="" onerror="this.style.display='none'"/></div></div>
  </div>
  <script define:vars={{blogsData:blogs.map(b=>({slug:b.slug,title:b.data.title,date:b.data.date,links:b.data.links,body:b.body,isPublic:b.data.public!==false,lockReason:b.data.lockReason||'',starred:!!b.data.starred})),allContent}}>
    const list=document.getElementById('blog-list'),reader=document.getElementById('blog-reader'),md=window.__BT_MD;let popupEl=null;
    function isAdmin(){return !!(window).__BT_ADMIN}
    const lockSvg=`<svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`;
    function lockScreen(r){return `<div class="reader-card animate-fade-in-up" style="text-align:center;padding:80px 56px;"><div style="margin:0 auto 20px;opacity:.2;width:56px;">${lockSvg}</div><h2 style="font-size:1.2rem;font-weight:600;color:var(--gray-700);margin-bottom:12px;font-family:'Noto Sans SC',sans-serif;">当前内容未公开</h2><p style="font-size:.875rem;color:var(--gray-400);font-family:'Noto Sans SC',sans-serif;line-height:1.8;max-width:360px;margin:0 auto;white-space:pre-line;">${r||'作者暂未公开此内容'}</p></div>`}
    const starHint=`<div class="starred-hint"><svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg><span>这是作者偏爱的作品之一</span></div>`;
    const adminBadge=t=>!t?`<span style="font-size:.6875rem;font-family:'Noto Sans SC',sans-serif;padding:1px 8px;border-radius:4px;color:#f59e0b;background:rgba(245,158,11,.1);margin-left:8px;">未公开</span>`:'';

    list.addEventListener('click',e=>{const item=e.target.closest('.list-item');if(!item)return;const blog=blogsData.find(b=>b.slug===item.dataset.id);if(!blog)return;list.querySelectorAll('.list-item').forEach(i=>i.classList.remove('active'));item.classList.add('active');reader.scrollTop=0;if(popupEl){popupEl.remove();popupEl=null}
      if(!blog.isPublic&&!isAdmin()){reader.innerHTML=lockScreen(blog.lockReason);return}
      const bodyHtml=md.renderMarkdown(blog.body,{linkReplacer:(_,text,type,id)=>`<span class="inline-link" data-type="${type}" data-id="${id}">${text}</span>`});
      reader.innerHTML=`<div class="reader-card animate-fade-in-up"><h1 class="reader-title">${blog.title}${adminBadge(blog.isPublic)}</h1>${blog.starred?starHint:''}<div class="reader-meta"><span class="list-item-date">${blog.date}</span><span class="reading-time"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>${Math.max(1,Math.round((blog.body||'').length/400))} 分钟阅读</span></div><div class="prose-content">${bodyHtml}</div></div>`;
    });
    reader.addEventListener('click',e=>{const link=e.target.closest('.inline-link');if(!link)return;if(popupEl){popupEl.remove();popupEl=null}const type=link.dataset.type,id=link.dataset.id;const target=allContent.find(c=>c.slug===id||c.slug===id.replace(/^(poem|song|blog|note)-/,''));if(!target)return;const tl={poem:'诗歌',song:'音乐',blog:'博客',note:'笔记'},pu={poem:'/poetry',song:'/music',blog:'/blog',note:'/notes'};const popup=document.createElement('div');popup.className='popup-panel';popup.style.cssText=`left:${Math.min(e.clientX+10,window.innerWidth-340)}px;top:${Math.min(e.clientY-20,window.innerHeight-300)}px;width:320px;`;popup.innerHTML=`<div class="modal-handle" id="ph" style="padding:10px 14px;background:var(--gray-50);"><div style="display:flex;align-items:center;gap:8px;"><svg width="10" height="10" viewBox="0 0 12 12" fill="#a3a3a3"><circle cx="3" cy="3" r="1.5"/><circle cx="9" cy="3" r="1.5"/><circle cx="3" cy="6" r="1.5"/><circle cx="9" cy="6" r="1.5"/><circle cx="3" cy="9" r="1.5"/><circle cx="9" cy="9" r="1.5"/></svg><span class="tag-accent">${tl[type]||type}</span></div><button class="modal-close" id="pc" style="width:24px;height:24px;font-size:1rem;">×</button></div><div style="padding:14px 18px;"><h3 style="font-size:1rem;font-weight:600;color:var(--gray-800);margin-bottom:8px;font-family:'Noto Serif SC',serif;">${target.title}</h3><p style="font-size:.8125rem;line-height:1.8;color:var(--gray-500);white-space:pre-line;max-height:80px;overflow:hidden;">${target.excerpt}…</p><a href="${pu[type]||'#'}" style="display:block;margin-top:12px;font-size:.8125rem;color:var(--color-accent);font-family:'Noto Sans SC',sans-serif;text-decoration:none;">→ 前往${tl[type]||''}页查看全文</a></div>`;document.body.appendChild(popup);popupEl=popup;let d=false,ox=0,oy=0;popup.querySelector('#ph').addEventListener('mousedown',ev=>{d=true;ox=ev.clientX-popup.getBoundingClientRect().left;oy=ev.clientY-popup.getBoundingClientRect().top});document.addEventListener('mousemove',ev=>{if(!d)return;popup.style.left=(ev.clientX-ox)+'px';popup.style.top=(ev.clientY-oy)+'px'});document.addEventListener('mouseup',()=>{d=false});popup.querySelector('#pc').addEventListener('click',()=>{popup.remove();popupEl=null})});
    document.addEventListener('click',e=>{if(popupEl&&!popupEl.contains(e.target)&&!e.target.closest('.inline-link')){popupEl.remove();popupEl=null}});
  </script>
</BaseLayout>

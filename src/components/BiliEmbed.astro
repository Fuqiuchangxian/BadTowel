---
interface Props {
  bvid: string;
}
const { bvid } = Astro.props;
const src = `https://player.bilibili.com/player.html?bvid=${bvid}&autoplay=0&high_quality=1&danmaku=0`;
const page = `https://www.bilibili.com/video/${bvid}`;
---

<figure class="bili">
  <div class="frame">
    <iframe
      src={src}
      title={`Bilibili 视频 ${bvid}`}
      loading="lazy"
      allowfullscreen
      scrolling="no"
      referrerpolicy="no-referrer-when-downgrade"></iframe>
  </div>
  <figcaption>
    <a class="link ext" href={page} target="_blank" rel="noopener noreferrer">在 B 站打开</a>
  </figcaption>
</figure>

<style>
  .bili { margin: 0; }
  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: #111;
  }
  iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  figcaption { margin-top: 10px; font-size: 14px; }
</style>

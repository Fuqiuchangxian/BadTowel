---
// 一行可展开的条目：「图标 标题 / 副标题 …… 右侧小字」，点开看全文。
// 同一页里每次只展开一个：点开另一个，上一个会收回去。
import Mark from './Mark.astro';
import type { ComponentProps } from 'astro/types';

interface Props {
  title: string;
  sub?: string;
  meta?: string;
  icon?: ComponentProps<typeof Mark>['name'];
  open?: boolean;
}
const { title, sub, meta, icon, open = false } = Astro.props;
---

<details class="fold" open={open}>
  <summary>
    <span class="t">{icon && <Mark name={icon} />}<span class="tt">{title}</span></span>
    {sub && <span class="sub">{sub}</span>}
    {meta && <span class="meta">{meta}</span>}
    <span class="plus" aria-hidden="true"></span>
  </summary>
  <div class="body">
    <div class="inner">
      <slot />
    </div>
  </div>
</details>

<style>
  summary {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto 1em;
    grid-template-areas: 't sub meta plus';
    align-items: baseline;
    column-gap: 10px;
    padding: 7px 0;
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker { display: none; }
  .t { grid-area: t; display: inline-flex; align-items: baseline; gap: 0.6em; transition: font-weight 0.2s; }
  .t :global(.mark) { align-self: center; }
  summary:hover .tt { text-decoration: underline; text-underline-offset: 0.3em; text-decoration-thickness: 1px; }
  .fold[open]:not(.closing) .tt { font-weight: 600; }
  .sub {
    grid-area: sub;
    color: var(--gray);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sub::before { content: '/'; margin-right: 10px; color: var(--faint); }
  summary .meta { grid-area: meta; }

  /* 右侧的 + ：展开时转成 × */
  .plus { grid-area: plus; position: relative; align-self: center; justify-self: end; width: 10px; height: 10px; color: var(--gray); transition: transform 0.35s cubic-bezier(0.22, 0.8, 0.28, 1); }
  .plus::before, .plus::after { content: ''; position: absolute; background: currentColor; }
  .plus::before { left: 0; right: 0; top: 4.5px; height: 1px; }
  .plus::after { top: 0; bottom: 0; left: 4.5px; width: 1px; }
  summary:hover .plus { color: var(--ink); }
  .fold[open]:not(.closing) .plus { transform: rotate(45deg); }

  /* 展开的内容：缩进 + 一条竖线，和上一层的行明显区分开 */
  .body { overflow: clip; }
  .inner {
    margin: 4px 0 28px 8px;
    padding: 4px 0 4px 22px;
    border-left: 1px solid var(--faint);
    font-size: 15px;
    line-height: 1.85;
  }
  .inner :global(p + p) { margin-top: 1em; }

  @media (max-width: 600px) {
    summary { grid-template-columns: minmax(0, 1fr) auto 1em; grid-template-areas: 't meta plus' 'sub sub sub'; }
    .sub { white-space: normal; overflow: visible; font-size: 14px; padding-left: 0; }
    .sub::before { display: none; }
    .inner { margin-left: 4px; padding-left: 16px; }
  }
</style>

<script>
  const DURATION = 360;
  const EASE = 'cubic-bezier(0.22, 0.8, 0.28, 1)';
  const reduced = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

  type Fold = HTMLDetailsElement;
  const bodyOf = (d: Fold) => d.querySelector<HTMLElement>(':scope > .body')!;

  function run(d: Fold, open: boolean) {
    const body = bodyOf(d);
    // 动画进行到一半被打断时，从当前高度接着走
    const from = body.getBoundingClientRect().height;
    body.getAnimations().forEach((a) => a.cancel());

    if (open) {
      d.classList.remove('closing');
      const startFrom = d.open ? from : 0;
      d.open = true;
      if (reduced()) return;
      const to = body.scrollHeight;
      body
        .animate(
          { height: [`${startFrom}px`, `${to}px`], opacity: [startFrom ? 1 : 0, 1] },
          { duration: DURATION, easing: EASE },
        )
        .finished.then(() => keepInView(d), () => {});
    } else {
      if (!d.open) return;
      if (reduced()) {
        d.open = false;
        return;
      }
      d.classList.add('closing');
      body
        .animate({ height: [`${from}px`, '0px'], opacity: [1, 0] }, { duration: DURATION, easing: EASE })
        .finished.then(
          () => {
            d.open = false;
            d.classList.remove('closing');
          },
          () => {},
        );
    }
  }

  // 上面的条目收起后，被点开的这一行可能被顶到屏幕外，滚回来
  function keepInView(d: Fold) {
    const top = d.querySelector('summary')!.getBoundingClientRect().top;
    if (top < 0) scrollBy({ top: top - 24, behavior: 'smooth' });
  }

  document.addEventListener('click', (e) => {
    const summary = (e.target as Element).closest?.('.fold > summary');
    if (!summary) return;
    e.preventDefault();
    const d = summary.parentElement as Fold;
    const willOpen = !d.open || d.classList.contains('closing');
    if (willOpen) {
      document.querySelectorAll<Fold>('.fold[open]:not(.closing)').forEach((o) => o !== d && run(o, false));
    }
    run(d, willOpen);
  });
</script>

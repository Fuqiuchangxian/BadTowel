---
import { manifesto } from '../data/site';
---

<section class="manifesto" aria-label="宣言">
  <div class="glow" aria-hidden="true"></div>
  <div class="wrap">
    {
      manifesto.map((line, i) => (
        <p class:list={['line', 'reveal', { last: i === manifesto.length - 1 }]} style={`--d:${i * 140}ms`}>
          {line}
        </p>
      ))
    }
  </div>
</section>

<style>
  .manifesto {
    position: relative;
    overflow: hidden;
    background: var(--black);
    color: #fff;
    padding: clamp(120px, 18vw, 220px) 0;
    text-align: center;
  }
  .glow {
    position: absolute;
    left: 50%;
    bottom: -60%;
    width: 110vmax;
    aspect-ratio: 2 / 1;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(52, 199, 89, 0.35), rgba(10, 132, 255, 0.22) 40%, transparent 68%);
    filter: blur(20px);
    pointer-events: none;
  }
  .wrap { position: relative; }
  .line {
    font-size: clamp(26px, 4.4vw, 52px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.35;
    color: rgba(255, 255, 255, 0.42);
  }
  .line + .line { margin-top: 0.35em; }
  .line:first-child { color: #fff; }
  .last {
    background: linear-gradient(100deg, var(--sky-1), var(--grass-1));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
</style>

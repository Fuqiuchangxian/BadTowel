---
import type { Experience } from '../data/site';

interface Props {
  item: Experience;
}
const { item } = Astro.props;
---

<article class="exp reveal">
  <div class="meta">
    <span class="dot" aria-hidden="true"></span>
    <p class="period mono">{item.period}</p>
    <h3 class="company">{item.company}</h3>
    <p class="role">{item.role}</p>
  </div>
  <div class="body">
    {item.companyIntro && <p class="intro">{item.companyIntro}</p>}
    <p class="summary">{item.summary}</p>
    {
      item.bullets.length > 0 && (
        <ul class="bullets">
          {item.bullets.map((b) => (
            <li>
              <h4>{b.title}</h4>
              <p>{b.text}</p>
            </li>
          ))}
        </ul>
      )
    }
    {item.note && <p class="note">{item.note}</p>}
    {
      item.caseStudy && (
        <a class="case" href={item.caseStudy.href}>
          <span class="case-k mono">CASE STUDY</span>
          <span class="case-t">{item.caseStudy.label}</span>
          <span class="case-arrow" aria-hidden="true">→</span>
        </a>
      )
    }
  </div>
</article>

<style>
  .exp {
    position: relative;
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 48px;
    padding: 48px 0;
    border-top: 1px solid var(--line);
  }
  .exp:last-child { border-bottom: 1px solid var(--line); }
  .meta { position: sticky; top: calc(var(--nav-h) + 32px); align-self: start; }
  .dot {
    display: block;
    width: 10px; height: 10px;
    margin-bottom: 18px;
    border-radius: 50%;
    background: var(--accent-grad);
  }
  .period { color: var(--ink-3); margin-bottom: 10px; }
  .company { font-size: 32px; font-weight: 700; letter-spacing: -0.02em; }
  .role { margin-top: 8px; font-size: 15px; color: var(--ink-2); line-height: 1.5; }

  .intro {
    margin-bottom: 18px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
    color: var(--ink-2);
  }
  .summary { font-size: 19px; line-height: 1.65; }
  .bullets {
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .bullets li {
    padding: 24px;
    border-radius: var(--radius);
    background: var(--bg);
    border: 1px solid var(--line-soft);
    transition: border-color 0.3s var(--ease), transform 0.4s var(--ease);
  }
  .bullets li:hover { border-color: var(--line); transform: translateY(-2px); }
  .bullets li:last-child:nth-child(odd) { grid-column: 1 / -1; }
  .bullets h4 { font-size: 17px; margin-bottom: 10px; }
  .bullets p { font-size: 14.5px; line-height: 1.7; color: var(--ink-2); }
  .note {
    margin-top: 24px;
    padding-left: 16px;
    border-left: 2px solid var(--line);
    font-size: 15px;
    color: var(--ink-2);
  }
  .case {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    column-gap: 16px;
    margin-top: 28px;
    padding: 22px 26px;
    border-radius: var(--radius);
    background: var(--black);
    color: #fff;
    overflow: hidden;
    position: relative;
    transition: transform 0.4s var(--ease);
  }
  .case::before {
    content: '';
    position: absolute;
    inset: auto -20% -120% auto;
    width: 60%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(90, 200, 250, 0.55), transparent 65%);
    transition: transform 0.6s var(--ease);
  }
  .case:hover { transform: translateY(-2px); }
  .case:hover::before { transform: translate(-10%, -10%) scale(1.2); }
  .case-k { grid-column: 1; color: rgba(255, 255, 255, 0.55); font-size: 11px; position: relative; }
  .case-t { grid-column: 1; font-size: 19px; font-weight: 600; position: relative; }
  .case-arrow { grid-column: 2; grid-row: 1 / span 2; font-size: 22px; position: relative; transition: transform 0.3s var(--ease); }
  .case:hover .case-arrow { transform: translateX(4px); }

  @media (max-width: 1023px) {
    .exp { grid-template-columns: 1fr; gap: 24px; }
    .meta { position: static; }
  }
  @media (max-width: 734px) {
    .bullets { grid-template-columns: 1fr; }
    .summary { font-size: 17px; }
    .company { font-size: 28px; }
  }
</style>

---
// 黑白小图标：16×16 的线条图形，颜色跟随文字。
interface Props {
  name: keyof typeof glyphs;
  size?: number;
}

const glyphs = {
  // 站点标志：一条毛巾，下摆有流苏
  towel: '<rect x="2.5" y="2.5" width="11" height="8" rx="1"/><path d="M5 10.5v3M8 10.5v3M11 10.5v3"/>',
  mail: '<rect x="2" y="3.5" width="12" height="9" rx="1.2"/><path d="m2.5 4.5 5.5 4.5 5.5-4.5"/>',
  code: '<path d="m5.5 4.5-3.5 3.5 3.5 3.5M10.5 4.5l3.5 3.5-3.5 3.5"/>',
  user: '<circle cx="8" cy="5.5" r="2.5"/><path d="M3 13.5c.6-2.6 2.5-4 5-4s4.4 1.4 5 4"/>',
  doc: '<path d="M4 2h5.5L12.5 5v9H4z"/><path d="M9.5 2v3h3M6 8.5h4.5M6 11h4.5"/>',
  spark: '<path d="M8 2v3.5M8 10.5V14M2 8h3.5M10.5 8H14M4 4l2 2M10 10l2 2M12 4l-2 2M6 10l-2 2"/>',
  search: '<circle cx="7" cy="7" r="4"/><path d="m10 10 3.5 3.5"/>',
  pen: '<path d="M3 13l.8-3L11 2.8a1.4 1.4 0 0 1 2 2L5.8 12z"/><path d="m9.8 4 2 2"/>',
  flask: '<path d="M6.5 2.5h3M7 2.5v4L3.5 12.5a1 1 0 0 0 .9 1.5h7.2a1 1 0 0 0 .9-1.5L9 6.5v-4"/><path d="M5 10h6"/>',
  award: '<circle cx="8" cy="6" r="3.5"/><path d="m6 9 -1 5 3-1.6L11 14l-1-5"/>',
  globe: '<circle cx="8" cy="8" r="6"/><path d="M2 8h12M8 2c2 1.8 2.8 3.8 2.8 6S10 12.2 8 14c-2-1.8-2.8-3.8-2.8-6S6 3.8 8 2z"/>',
  slides: '<rect x="2" y="3" width="12" height="8" rx="1"/><path d="M8 11v2.5M5.5 13.5h5"/>',
  chart: '<path d="M2.5 13.5h11M4.5 13V8M8 13V4M11.5 13V6.5"/>',
  image: '<rect x="2" y="3" width="12" height="10" rx="1"/><circle cx="5.8" cy="6.3" r="1"/><path d="m2.5 12 3.8-3.5 2.7 2.5 2-1.8 2.5 2.3"/>',
  shapes: '<circle cx="5.5" cy="5.5" r="3"/><rect x="8" y="8" width="5.5" height="5.5" rx=".6"/>',
  music: '<path d="M6 11.8V3l7-1.5v8.8"/><circle cx="4.5" cy="11.8" r="1.7"/><circle cx="11.5" cy="10.3" r="1.7"/>',
  chat: '<path d="M2.5 3.5h11v7h-6l-3 3v-3h-2z"/>',
  book: '<path d="M2.5 3.5c2-.8 4-.6 5.5.6 1.5-1.2 3.5-1.4 5.5-.6v9c-2-.8-4-.6-5.5.6-1.5-1.2-3.5-1.4-5.5-.6zM8 4.1v9"/>',
  feather: '<path d="M13 3c-5 0-8 3-8 7l-2 3.5M5 10c2 .5 5 0 6.5-3M6.5 7.5C8 7 9.5 6.5 10.5 5"/>',
  arrow: '<path d="M3 8h10M9 4l4 4-4 4"/>',
  dots: '<circle cx="4" cy="8" r=".6"/><circle cx="8" cy="8" r=".6"/><circle cx="12" cy="8" r=".6"/>',
} as const;

const { name, size = 16 } = Astro.props;
---

<svg
  class="mark"
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.3"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={glyphs[name]}
/>

<style>
  .mark { display: inline-block; flex: none; vertical-align: -0.2em; }
</style>
